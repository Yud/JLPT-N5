# WaniKani personal access token (wanikani.com → Settings → API Tokens).
# Used only by scripts/sync-wanikani-words.mjs (npm run sync:wanikani),
# which populates your *local* D1 database for development — production's
# cache is refreshed via the "Sync from WaniKani" button in the app itself
# (see .dev.vars.example for testing that path locally). Never bundled into
# the app, sent to Cloudflare, or committed anywhere — copy this file to
# .env (gitignored) and fill in real values there.
WANIKANI_API_KEY=

# Minimum WaniKani SRS stage a word must be at to be cached locally (1-9:
# Apprentice I-IV, Guru I-II, Master, Enlightened, Burned). Optional —
# overridden by --min-srs-stage on the command line; defaults to 6 (Guru
# II) if unset, deliberately lower than production's Master default so
# there's enough sample data to test with.
WANIKANI_MIN_SRS_STAGE=
