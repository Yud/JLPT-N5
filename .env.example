# The one local config file: copy this to .env (gitignored) and fill in real
# values there. Read by scripts/sync-wanikani-words.mjs, and auto-loaded by
# wrangler (npm run dev:api / npm test) into the Functions' local env.
# Don't create a .dev.vars — when one exists, wrangler loads it *instead of*
# .env, silently dropping everything below. Never bundled into the app,
# sent to Cloudflare, or committed anywhere.

# WaniKani personal access token (wanikani.com → Settings → API Tokens).
# Used by scripts/sync-wanikani-words.mjs (npm run sync:wanikani) to populate
# your *local* D1, and locally by the "Sync from WaniKani" button and the
# WaniKani SRS page (functions/api/wanikani-words/sync.js,
# functions/api/wanikani/srs-items.js).
WANIKANI_API_KEY=

# Minimum WaniKani SRS stage a word must be at to be cached locally (1-9:
# Apprentice I-IV, Guru I-II, Master, Enlightened, Burned). Optional —
# overridden by --min-srs-stage on the command line; defaults to 6 (Guru
# II) if unset, deliberately lower than production's Master default so
# there's enough sample data to test with.
WANIKANI_MIN_SRS_STAGE=

# Fish Audio API key for the Text to Speech page (functions/api/tts/fish.js).
FISH_API_KEY=

# R2 S3-API credentials + account id, used to presign direct-to-R2 deck
# uploads (functions/api/decks/import.js). Create an R2 API token in the
# Cloudflare dashboard (R2 → Manage API tokens).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
CF_ACCOUNT_ID=
